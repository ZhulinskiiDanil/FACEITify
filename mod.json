{
    "geode": "5.10.1",
    "gd": {
        "win": "2.2081",
        "android": "2.2081",
        "mac": "2.2081",
        "ios": "2.2081"
    },
    "id": "zhulis.faceitify",
    "name": "FACEITify",
    "version": "v1.1.0",
    "developer": "Zhulis",
    "description": "FACEIT-style difficulty badges",
    "settings": {
        "list": {
            "name": "Demon list",
            "description": "Which list hands out the <cg>Challenger</c> badges and rates the demons GD never got round to. <cy>demonlist.org</c> and <cy>Pointercrate</c> are the classic top; <cy>AREDL</c> covers every rated extreme.",
            "type": "string",
            "default": "demonlist.org",
            "one-of": [
                "demonlist.org",
                "Pointercrate",
                "AREDL",
                "Off"
            ]
        },
        "animate": {
            "name": "Animate the badge",
            "description": "The ring fills up to the level when a level page opens.",
            "type": "bool",
            "default": true
        }
    },
    "dependencies": {
        "geode.node-ids": ">=v1.23.3"
    },
    "incompatibilities": {
        "uproxide.more_difficulties": {
            "version": ">=v1.0.0",
            "breaking": true
        }
    },
    "links": {
        "community": "https://discord.gg/z9pmtkHX9b",
        "source": "https://github.com/ZhulinskiiDanil/FACEITify"
    },
    "issues": {
        "info": "Free-form info about where and how to report issues. Supports markdown formatting",
        "url": "https://github.com/ZhulinskiiDanil/FACEITify/issues"
    },
    "resources": {
        "sprites": [
            "resources/faceitLevelTemplate.png",
            "resources/faceitChallenger.png",
            "resources/faceitInvalid.png"
        ]
    }
}